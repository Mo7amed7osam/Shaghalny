# Copy to backend/.env and fill in real values. Never commit backend/.env.

# Database
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=shaghalny
JWT_SECRET=change-me

# Server
PORT=5000
FRONTEND_URL=http://localhost:5173
# DEMO_MODE=false
# PAYMENTS_ENABLED=false

# AI provider (OpenRouter, shared by cover letters, roadmaps, interviews and the companion)
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=openai/gpt-4o-mini
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=

# Shaghol companion
# Provider for the companion only: "gemini" (default, official @google/genai SDK) or "openrouter".
# There is no automatic switch to another provider or model; failures use the demo fallback below.
COMPANION_PROVIDER=gemini
# GEMINI_API_KEY=   (set on the server only; leave unset locally to get the clearer "not configured" demo state)
# Gemini model; must support function calling. Default gemini-3.6-flash has a free tier
# (check https://ai.google.dev/gemini-api/docs/pricing before changing it).
# COMPANION_GEMINI_MODEL=gemini-3.6-flash
# OpenRouter model when COMPANION_PROVIDER=openrouter (uses OPENROUTER_API_KEY above); must support tools.
# COMPANION_MODEL=
# "demo" shows clearly labelled demo responses when no key is set or the provider fails.
# Leave empty to show an error instead.
COMPANION_FALLBACK_MODE=demo
# COMPANION_TIMEOUT_MS=30000
# COMPANION_RATE_LIMIT=30

# Uploads / email (optional)
# CLOUDINARY_URL=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
